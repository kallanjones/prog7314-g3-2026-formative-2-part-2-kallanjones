<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only.

  Permits plain HTTP so the app can reach the EventFinder API while it runs
  locally without a TLS certificate — either on the emulator loopback
  (10.0.2.2) or on a laptop's LAN address (192.168.x.x / 10.x.x.x) when testing
  on a physical phone. LAN addresses vary by network, so they cannot be listed
  individually.

  This file is in src/debug, so it applies to debug builds only. Release builds
  use the main manifest, which sets usesCleartextTraffic="false" and is
  therefore HTTPS-only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
